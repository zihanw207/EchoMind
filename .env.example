# Copy this file to .env and fill in values locally. Never commit .env.
ANTHROPIC_API_KEY=
# Leave blank for the official Anthropic API, or set a compatible endpoint.
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# Set a key to enable Jev routing.
TYPESAFE_API_KEY=
ECHOMIND_JEV_MODEL=jev-latest
ECHOMIND_JEV_TECHNICAL_THRESHOLD=0.5
ECHOMIND_JEV_BILLING_THRESHOLD=0.5
ECHOMIND_JEV_HANDOFF_THRESHOLD=0.5
# Generate a password with: openssl rand -hex 24
REDIS_PASSWORD=
FRONTEND_PORT=5174
