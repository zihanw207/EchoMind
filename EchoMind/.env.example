# Copy to .env and configure locally. Do not commit real credentials.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
APP_ENV=production
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
# Generate a password with: openssl rand -hex 24
REDIS_PASSWORD=
# Docker Compose sets the authenticated Redis URL automatically.
# For local Python execution, set REDIS_URL in your local .env.
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_PERSIST_DIRECTORY=/app/data/chroma
MONITOR_INTERVAL=10
ALERT_WEBHOOK_URL=
